{
  "build_environment": {
    "CGO_ENABLED": "0",
    "GOMAXPROCS": "8",
    "GOPROXY": "file:///app/offline-module-proxy",
    "GOSUMDB": "off",
    "GOTOOLCHAIN": "local"
  },
  "build_source_env": "OPTIMBENCH_SOURCE",
  "calibration_max_age_seconds": 86400,
  "claimable": false,
  "cores": 8,
  "differential": {
    "enabled": true,
    "command": [
      "python3",
      "/verifier-differential/run.py"
    ],
    "seeds": [
      1729,
      2718,
      31415
    ],
    "case_budget": 16,
    "case_timeout_seconds": 30,
    "time_cap_seconds": 600
  },
  "heldout_status": "available",
  "maximum_pairs": 15,
  "memory": "16g",
  "minimum_pairs": 5,
  "noise_thresholds": {
    "max_sibling_busy": 0.1,
    "max_steal": 0.01,
    "max_throttled": 0.01
  },
  "pids_limit": 512,
  "process_state": {
    "enabled": true,
    "kind": "goldmark"
  },
  "protocol": "eight-core-rmit-aa-v1",
  "public_interface": {
    "files": [
      "project/ast/*.go",
      "project/parser/*.go",
      "project/renderer/**/*.go",
      "project/text/*.go",
      "project/util/*.go",
      "project/extension/**/*.go"
    ],
    "kind": "declarations",
    "language": "go"
  },
  "relative_ci_half_width": 0.02,
  "review_required": true,
  "upstream_gate": {
    "command": [
      "python3",
      "/judge-task-tests/upstream.py",
      "goldmark"
    ],
    "report": "upstream.json",
    "timeout": 7200
  },
  "warmups": 1,
  "case_roles": {
    "heldout": {
      "heldout-batch": "performance",
      "parse-only": "performance"
    },
    "public": {
      "batch": "performance",
      "parse-only": "performance"
    }
  },
  "performance_units": {
    "heldout": {
      "gfm-html": [
        "heldout-batch"
      ],
      "parse-only": [
        "parse-only"
      ]
    },
    "public": {
      "gfm-html": [
        "batch"
      ],
      "parse-only": [
        "parse-only"
      ]
    }
  },
  "qualification_notes": "The original `gfm-html` and `parse-only` units, complete output contracts, and native verifier adapters are preserved. See [public reproduction](tests/README.md) for hydrated-export acquisition, source-only candidate submission, protected checks, licenses, and native generic gates."
}
