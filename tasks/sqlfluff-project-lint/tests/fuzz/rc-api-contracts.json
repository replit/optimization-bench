{
  "contracts": {
    "file_persistence": "LintedFile returned by public lint_string accepts encoding; public persist_tree writes fixes to owned files; UTF8 succeeds and ASCII Unicode output raises a stable encoding failure",
    "persistent": "reuse a real public Linter; interleave explicit per-call FluffConfig dialect/rule/fix settings with fresh Linter instances and compare fresh-process oracles",
    "read_failures": "public lint_paths accepts paths/processes/fix/apply_fixes; real missing/unreadable owned paths are observed, not mocked",
    "returned_violations": "malformed SQL is a documented public input producing returned parse violations; all records and get_violations are observed without assuming exceptions",
    "scope_limit": "only these registered public calls are covered; no arbitrary writer callback or complete API coverage is claimed"
  },
  "faults_are_OS_or_encoding_not_private_monkeypatches": true,
  "format": "sqlfluff-rc-public-api-contract-evidence-v1",
  "methods": {
    "sqlfluff.core.linter.linted_file:LintedFile.fix_string": {
      "definition_module": "sqlfluff.core.linter.linted_file",
      "doc": "Obtain the changes to a path as a string.\n\nWe use the source mapping features of TemplatedFile\nto generate a list of \"patches\" which cover the non\ntemplated parts of the file and refer back to the locations\nin the original file.\n\nNB: This is MUCH FASTER than the original approach\nusing difflib in pre 0.4.0.\n\nThere is an important distinction here between Slices and\nSegments. A Slice is a portion of a file which is determined\nby the templater based on which portions of the source file\nare templated or not, and therefore before Lexing and so is\ncompletely dialect agnostic. A Segment is determined by the\nLexer from portions of strings after templating.",
      "parameters": [
        {
          "has_default": false,
          "kind": "POSITIONAL_OR_KEYWORD",
          "name": "self"
        }
      ]
    },
