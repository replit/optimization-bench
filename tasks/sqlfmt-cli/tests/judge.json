{
  "qualification_notes": "Public reproduction, source-only exports and data terms are documented in [tests/README.md](tests/README.md). All public SQL bodies are fetch-only. Sourcegraph-licensed CLI inputs are excluded; the final image holds no input bodies.",
  "build_source_env": "OPTIMBENCH_SOURCE",
  "calibration_max_age_seconds": 86400,
  "claimable": false,
  "cores": 8,
  "differential": {
    "stderr_contract": "cli-stderr-contract-v1",
    "enabled": true,
    "command": [
      "python3",
      "/verifier-differential/run.py"
    ],
    "seeds": [
      1729,
      2718,
      31415
    ],
    "case_budget": 24,
    "case_timeout_seconds": 30,
    "time_cap_seconds": 600
  },
  "heldout_status": "available",
  "maximum_pairs": 15,
  "memory": "16g",
  "minimum_pairs": 5,
  "noise_thresholds": {
    "max_sibling_busy": 0.1,
    "max_steal": 0.01,
    "max_throttled": 0.01
  },
  "pids_limit": 512,
  "process_state": {
    "enabled": true,
    "kind": "go_sqlfmt"
  },
  "protocol": "eight-core-rmit-aa-v1",
  "public_interface": {
    "files": [
      "project/format/*.go"
    ],
    "kind": "declarations",
    "language": "go"
  },
  "relative_ci_half_width": 0.02,
  "review_required": true,
  "upstream_gate": {
    "command": [
      "python3",
      "/judge-task-tests/upstream.py"
    ],
    "report": "upstream.json",
    "timeout": 7200
  },
  "warmups": 1
}
