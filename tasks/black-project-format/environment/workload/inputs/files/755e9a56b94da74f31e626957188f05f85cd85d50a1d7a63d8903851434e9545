th": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/ast.rst"}, {"code": "tree = ast.parse('print(None)', '?', 'eval')\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/ast.rst"}, {"code": "print(ast.dump(tree, indent=4))\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/ast.rst"}, {"code": "print(ast.dump(tree, indent=4, show_empty=True))\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/ast.rst"}, {"code": "import asyncio\n\nasync def test():\n    asyncio.print_call_graph()\n\nasync def main():\n    async with asyncio.TaskGroup() as g:\n        g.create_task(test(), name='test')\n\nasyncio.run(main())\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/asyncio-graph.rst"}, {"code": "import asyncio\nimport os\n\nasync def play(track):\n    await asyncio.sleep(3600)\n    print(f\"🎵 Finished: {track}\")\n\nasync def album(name, tracks):\n    async with asyncio.TaskGroup() as tg:\n        for track in tracks:\n            tg.create_task(play(track), name=track)\n\nasync def main():\n    print(f\"PID: {os.getpid()}\")\n    async with asyncio.TaskGroup() as tg:\n        tg.create_task(\n            album(\"Sundowning\", [\"TNDNBTG\", \"Levitate\"]),\n            name=\"Sundowning\",\n        )\n        tg.create_task(\n            album(\"TMBTE\", [\"DYWTYLM\", \"Aqua Regia\"]),\n            name=\"TMBTE\",\n        )\n\nasyncio.run(main())\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/asyncio-tools.rst"}, {"code": "import asyncio\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/asyncio.rst"}, {"code": "await asyncio.sleep(10, result='hello')\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/asyncio.rst"}, {"code": "import os\nos.remove(\"myfile.bz2\")\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/bz2.rst"}, {"code": "codecs.readbuffer_encode(b\"Zito\")\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/codecs.rst"}, {"code": "from collections.abc import *\nimport itertools\n__name__ = '<doctest>'\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "class C(Sequence):                      # Direct inheritance\n    def __init__(self): ...             # Extra method not required by the ABC\n    def __getitem__(self, index):  ...  # Required abstract method\n    def __len__(self):  ...             # Required abstract method\n    def count(self, value): ...         # Optionally override a mixin method\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "class D:                                 # No inheritance\n    def __init__(self): ...              # Extra method not required by the ABC\n    def __getitem__(self, index):  ...   # Abstract method\n    def __len__(self):  ...              # Abstract method\n    def count(self, value): ...          # Mixin method\n    def index(self, value): ...          # Mixin method\n\nSequence.register(D)                     # Register instead of inherit\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "class E:\n    def __iter__(self): ...\n    def __next__(self): ...\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "issubclass(C, Sequence)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "isinstance(C(), Sequence)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "issubclass(D, Sequence)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "isinstance(D(), Sequence)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "issubclass(E, Iterable)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "isinstance(E(), Iterable)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.abc.rst"}, {"code": "from collections import *\nimport itertools\n__name__ = '<doctest>'\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.rst"}, {"code": "from collections import OrderedDict\nfrom time import monotonic\n\nclass TimeBoundedLRU:\n    \"LRU Cache that invalidates and refreshes old entries.\"\n\n    def __init__(self, func, maxsize=128, maxage=30):\n        self.cache = OrderedDict()      # { args : (timestamp, result)}\n        self.func = func\n        self.maxsize = maxsize\n        self.maxage = maxage\n\n    def __call__(self, *args):\n        if args in self.cache:\n            self.cache.move_to_end(args)\n            timestamp, result = self.cache[args]\n            if monotonic() - timestamp <= self.maxage:\n                return result\n        result = self.func(*args)\n        self.cache[args] = monotonic(), result\n        if len(self.cache) > self.maxsize:\n            self.cache.popitem(last=False)\n        return result\n\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/collections.rst"}, {"code": "class MultiHitLRUCache:\n    \"\"\" LRU cache that defers caching a result until\n        it has been requested multiple times.\n\n        To avoid flushing the LRU cache with one-time requests,\n        we don't cache until a request has been made more than once.\n\n    \"\"\"\n\n    def __init__(self, func, maxsize=128, maxrequests=4096, cache_after=1):\n        self.requests = OrderedDict()   # { uncached_key : request_count }\n        self.cache = OrderedDict()      # { cached_key : function_result }\n        self.func = func\n        self.maxrequests = maxrequests  # max number of uncached requests\n        self.maxsize = maxsize          # max number of stored return values\n        self.cache_after = cache_after\n\n    def __call__(self, *args):\n        if args in self.cache:\n            se