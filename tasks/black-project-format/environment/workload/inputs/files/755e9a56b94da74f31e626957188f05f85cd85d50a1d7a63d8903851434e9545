, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "# Dwarf planets:   Pluto,  Eris,    Makemake, Haumea, Ceres\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "orbital_periods = [90_560, 204_199, 111_845, 103_410, 1_680]  # days\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "predicted_dist = [math.cbrt(slope * (p * p)) for p in orbital_periods]\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "list(map(round, predicted_dist))\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "[5_906, 10_152, 6_796, 6_450, 414]  # actual distance in million km\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "temperature_february = NormalDist(5, 2.5)             # Celsius\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "temperature_february * (9/5) + 32                     # Fahrenheit\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "birth_weights = NormalDist.from_samples([2.5, 3.1, 2.1, 2.4, 2.7, 3.5])\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "drug_effects = NormalDist(0.4, 0.15)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "combined = birth_weights + drug_effects\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "round(combined.mean, 1)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "round(combined.stdev, 1)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "sat = NormalDist(1060, 195)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "fraction = sat.cdf(1200 + 0.5) - sat.cdf(1100 - 0.5)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "round(fraction * 100.0, 1)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "list(map(round, sat.quantiles()))\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "list(map(round, sat.quantiles(n=10)))\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "def model(x, y, z):\n    return (3*x + 7*x*y - 5*y) / (11 * z)\n\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "n = 100_000\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "X = NormalDist(10, 2.5).samples(n, seed=3652260728)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "Y = NormalDist(15, 1.75).samples(n, seed=4582495471)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "Z = NormalDist(50, 1.25).samples(n, seed=6582483453)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "quantiles(map(model, X, Y, Z))       # doctest: +SKIP\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "n = 750             # Sample size\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "p = 0.65            # Preference for Python\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "q = 1.0 - p         # Preference for Ruby\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "k = 500             # Room capacity\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "# Approximation using the cumulative normal distribution\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "from math import sqrt\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "round(NormalDist(mu=n*p, sigma=sqrt(n*p*q)).cdf(k + 0.5), 4)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "# Exact solution using the cumulative binomial distribution\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "from math import comb, fsum\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "round(fsum(comb(n, r) * p**r * q**(n-r) for r in range(k+1)), 4)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "# Approximation using a simulation\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "from random import seed, binomialvariate\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "seed(8675309)\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "mean(binomialvariate(n, p) <= k for i in range(10_000))\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "height_male = NormalDist.from_samples([6, 5.92, 5.58, 5.92])\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "height_female = NormalDist.from_samples([5, 5.5, 5.42, 5.75])\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "weight_male = NormalDist.from_samples([180, 190, 170, 165])\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "weight_female = NormalDist.from_samples([100, 150, 130, 150])\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"}, {"code": "foot_size_male = NormalDist.from_samples([12, 11, 12, 10])\n", "mode": {"is_pyi": false, "line_length": 88, "preview": false, "string_normalization": true, "target_versions": []}, "source": "python_cpython:Doc/library/statistics.rst"},