{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optimbench:judge-host-registry:v1",
  "title": "Reviewed judge host registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hosts"],
  "properties": {
    "schema_version": {"const": 1},
    "hosts": {"type": "array", "items": {"$ref": "#/$defs/host"}},
    "configurations": {"type": "array", "items": {"$ref": "#/$defs/configuration"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "project_id", "zone", "instance_id", "machine_type",
        "architecture", "threads_per_core", "cpu_model", "cpu_flags_sha256",
        "kernel", "docker_version", "containerd_version", "judge_cpus", "system_cpus"
      ],
      "properties": {
        "provider": {"const": "gcp"},
        "project_id": {"type": "string", "minLength": 1},
        "zone": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "pattern": "^[0-9]+$"},
        "machine_type": {"type": "string", "minLength": 1},
        "architecture": {"enum": ["x86_64", "aarch64"]},
        "threads_per_core": {"const": 1},
        "cpu_model": {"type": "string", "minLength": 1},
        "cpu_flags_sha256": {"$ref": "#/$defs/sha256"},
        "kernel": {"type": "string", "minLength": 1},
        "docker_version": {"type": "string", "minLength": 1},
        "containerd_version": {"type": "string", "minLength": 1},
        "judge_cpus": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 7}
        },
        "system_cpus": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 8}
        }
      }
    },
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^judge/hosts/qualifications/[a-zA-Z0-9_./-]+\\.json(\\.gz)?$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "role", "fingerprint"],
      "properties": {
        "configuration_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$"},
        "role": {"const": "scoring"},
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "machine_type", "cpu_model", "architecture",
                       "threads_per_core", "judge_cpus", "system_cpus"],
          "properties": {
            "provider": {"$ref": "#/$defs/fingerprint/properties/provider"},
            "machine_type": {"enum": ["c4-standard-32"]},
            "cpu_model": {"$ref": "#/$defs/fingerprint/properties/cpu_model"},
            "architecture": {"const": "x86_64"},
            "threads_per_core": {"$ref": "#/$defs/fingerprint/properties/threads_per_core"},
            "judge_cpus": {"$ref": "#/$defs/fingerprint/properties/judge_cpus"},
            "system_cpus": {"$ref": "#/$defs/fingerprint/properties/system_cpus"}
          }
        },
        "review": {"$ref": "#/$defs/host/properties/review"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "role", "fingerprint", "review", "qualifications"],
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "scoring"}}},
          "then": {
            "properties": {
              "fingerprint": {
                "properties": {
                  "architecture": {"const": "x86_64"},
                  "machine_type": {"enum": ["c4-standard-32"]}
                }
              },
              "qualifications": {"minProperties": 1}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "portability"}}},
          "then": {
            "properties": {"fingerprint": {"properties": {"architecture": {"const": "aarch64"}}}}
          }
        }
      ],
      "properties": {
        "host_id": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$"},
        "role": {"enum": ["scoring", "portability"]},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pull_request"],
          "properties": {
            "pull_request": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
            }
          }
        },
        "qualifications": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]+$"},
          "additionalProperties": {"$ref": "#/$defs/receipt_ref"}
        }
      }
    }
  }
}
